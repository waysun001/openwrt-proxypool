config global 'global'
	option enabled '1'

config client 'first'
	option enabled '1'
	option name 'First'
	option type 'l2tp'
	option server 'first.example'
	option username 'first-user'
	option password 'first-password'
	list bind_ip '192.168.9.20'

config client 'second'
	option enabled '1'
	option name 'Second'
	option type 'l2tp'
	option server 'second.example'
	option username 'second-user'
	option password 'second-password'
	list bind_ip '192.168.9.20'
