# ProxyPool V2 configuration fixture
config global 'global'
	option schema_version '2'
	option revision '9'
	option enabled '1'
	option runtime_backend 'v2_shadow'
	option max_nodes '60'
	option lan_device 'br-lan'
	list management_port '80'
	list management_port '443'
	option l2tp_concurrency '4'
	option proxy_concurrency '5'
	option connect_timeout '30s'
	option stop_timeout '20s'
	list doh_url 'https://dns.example/dns-query'
	list doh_bootstrap_ip '192.0.2.53'
	list doh_server_name 'dns.example'

config node 'node-a'
	option name 'Alice node'
	option protocol 'l2tp'
	option enabled '1'
	option server 'l2tp.example'
	option port '1701'
	option username 'alice'
	option password 'fixture-password-not-real'
	option slp_token ''
	option slp_transport ''
	option slp_obfs '0'
	option slp_obfs_key ''
	option slp_insecure '0'
	option expires_at ''
	option policy_id '1'
	option revision '9'

config node 'node-b'
	option name "Bob's node"
	option protocol 'slp'
	option enabled '1'
	option server 'slp.example'
	option port '443'
	option username 'slp-user'
	option password 'fixture-password-not-real'
	option slp_token 'fixture-token-not-real'
	option slp_transport 'quic'
	option slp_obfs '1'
	option slp_obfs_key 'fixture-obfs-key-not-real'
	option slp_insecure '1'
	option expires_at '2030-01-02T03:04:05.123456789Z'
	option policy_id '2'
	option revision '9'

config device 'device-a'
	option mac '00:11:22:33:44:55'
	option hostname 'Alice phone'
	option fixed_ipv4 '192.0.2.10'
	option node_id 'node-a'
	option enabled '1'

config device 'device-b'
	option mac '00:11:22:33:44:66'
	option hostname "Bob's phone"
	option fixed_ipv4 '192.0.2.11'
	option node_id 'node-b'
	option enabled '0'
