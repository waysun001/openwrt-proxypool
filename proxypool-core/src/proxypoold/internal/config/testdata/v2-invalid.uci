config global 'global'
	option schema_version '2'
	option revision '7'
	option enabled '1'
	option runtime_backend 'v2_shadow'
	option max_nodes '60'
	option lan_device 'br-lan'
	list management_port '80'
	option l2tp_concurrency '4'
	option proxy_concurrency '5'
	option connect_timeout '30s'
	option stop_timeout '20s'
	option password 'fixture-password-not-real'
