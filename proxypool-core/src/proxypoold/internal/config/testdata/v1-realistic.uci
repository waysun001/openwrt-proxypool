config global 'global'
	option enabled '1'
	option max_clients '60'
	option log_level 'info'

config client 'l2tp-a'
	option enabled '1'
	option name 'Legacy L2TP'
	option type 'l2tp'
	option server 'vpn.example'
	option port '1701'
	option username 'legacy-user'
	option password 'legacy-password'
	option expiry '2027-01-02'
	list bind_ip '192.168.9.20'

config client 'socks_a'
	option enabled '0'
	option name 'Legacy SOCKS'
	option type 'socks5'
	option server 'proxy.example'
	option port '1080'
	option username 'proxy-user'
	option password 'proxy-password'
	list bind_ip '192.168.9.21'

config client 'slp_a'
	option enabled '0'
	option name 'Legacy SLP'
	option type 'slp'
	option server 'slp.example'
	option port '443'
	option slp_token 'legacy-token'
	option slp_transport 'quic'
	option slp_obfs '1'
	option slp_obfs_key 'legacy-obfs-key'
	option slp_insecure '0'
