#!/bin/sh /etc/rc.common
# 智联盒子服务启动脚本

START=99
STOP=10

PROG="/usr/lib/proxypool/proxypool.sh"

start() {
    local enabled
    config_load proxypool
    config_get enabled global enabled 1

    [ "$enabled" = "0" ] && return 0

    # 禁用系统 xl2tpd，避免占用 1701 端口导致独立实例冲突
    if /etc/init.d/xl2tpd enabled 2>/dev/null; then
        /etc/init.d/xl2tpd stop 2>/dev/null
        /etc/init.d/xl2tpd disable 2>/dev/null
    fi
    # 确保系统 xl2tpd 进程已停止
    local sys_pid
    sys_pid=$(cat /var/run/xl2tpd.pid 2>/dev/null)
    if [ -n "$sys_pid" ] && kill -0 "$sys_pid" 2>/dev/null; then
        kill "$sys_pid" 2>/dev/null
        sleep 1
    fi

    echo "Starting 智联盒子..."
    $PROG start

    # 使用期限：初始化本次开机的累计基准（基于 uptime 单调时钟）
    /usr/lib/proxypool/lease.sh boot 2>/dev/null

    # 注册 cron（幂等：先删旧条目再添加）
    sed -i '\|/usr/lib/proxypool/watchdog.sh|d' /etc/crontabs/root 2>/dev/null
    sed -i '\|/usr/lib/proxypool/lease.sh|d' /etc/crontabs/root 2>/dev/null
    echo "* * * * * /usr/lib/proxypool/watchdog.sh run" >> /etc/crontabs/root
    echo "*/5 * * * * /usr/lib/proxypool/lease.sh accrue" >> /etc/crontabs/root
    /etc/init.d/cron restart 2>/dev/null
}

stop() {
    echo "Stopping 智联盒子..."
    $PROG stop

    # 使用期限：停止前把实时累计落盘，避免丢失本次开机已累计的时长
    /usr/lib/proxypool/lease.sh flush 2>/dev/null

    # 移除 cron
    sed -i '\|/usr/lib/proxypool/watchdog.sh|d' /etc/crontabs/root 2>/dev/null
    sed -i '\|/usr/lib/proxypool/lease.sh|d' /etc/crontabs/root 2>/dev/null
    /etc/init.d/cron restart 2>/dev/null
}

restart() {
    stop
    sleep 2
    start
}

reload() {
    echo "Reloading 智联盒子..."
    $PROG reload
}
