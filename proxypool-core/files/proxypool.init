#!/bin/sh /etc/rc.common
# ProxyPool 服务启动脚本

START=99
STOP=10
USE_PROCD=1

PROG="/usr/lib/proxypool/proxypool.sh"
STATUS_PROG="/usr/lib/proxypool/status.sh"

start_service() {
    local enabled
    config_load proxypool
    config_get enabled global enabled 1

    [ "$enabled" = "0" ] && return 0

    # 启动主服务
    $PROG start

    # 启动状态监控 (后台)
    procd_open_instance status_monitor
    procd_set_param command $STATUS_PROG monitor
    procd_set_param respawn
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    $PROG stop
}

reload_service() {
    $PROG reload
}

service_triggers() {
    procd_add_reload_trigger "proxypool"
}
