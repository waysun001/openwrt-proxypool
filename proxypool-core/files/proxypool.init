#!/bin/sh /etc/rc.common
# 智联盒子服务启动脚本

START=99
STOP=10

PROG="/usr/lib/proxypool/proxypool.sh"

start() {
    local enabled
    config_load proxypool
    config_get enabled global enabled 1

    [ "$enabled" = "0" ] && return 0

    echo "Starting 智联盒子..."
    $PROG start
}

stop() {
    echo "Stopping 智联盒子..."
    $PROG stop
}

restart() {
    stop
    sleep 2
    start
}

reload() {
    echo "Reloading 智联盒子..."
    $PROG reload
}
