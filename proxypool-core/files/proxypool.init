#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG="${PROXYPOOL_LEGACY_PROG:-/usr/lib/proxypool/proxypool.sh}"
LEASE_PROG="${PROXYPOOL_LEASE_PROG:-/usr/lib/proxypool/lease.sh}"
WATCHDOG_PROG="${PROXYPOOL_WATCHDOG_PROG:-/usr/lib/proxypool/watchdog.sh}"
CRON_INIT="${PROXYPOOL_CRON_INIT:-/etc/init.d/cron}"
XL2TPD_INIT="${PROXYPOOL_XL2TPD_INIT:-/etc/init.d/xl2tpd}"
CRONTAB_ROOT="${PROXYPOOL_CRONTAB_ROOT:-/etc/crontabs/root}"
XL2TPD_PID="${PROXYPOOL_XL2TPD_PID:-/var/run/xl2tpd.pid}"

RUNTIME_MARKER="${PROXYPOOL_RUNTIME_MARKER:-/var/run/proxypool.backend}"
QUARANTINE_MARKER="${PROXYPOOL_QUARANTINE_MARKER:-/var/run/proxypool.backend.cleanup-required}"
TRANSITION_MARKER="${PROXYPOOL_TRANSITION_MARKER:-/var/run/proxypool.transition}"
ACTIVE_SNAPSHOT_MARKER="${PROXYPOOL_ACTIVE_SNAPSHOT_MARKER:-/var/run/proxypool.config-snapshot}"
LEGACY_RUN_DIR="${PROXYPOOL_LEGACY_RUN_DIR:-/var/run/proxypool}"
SNAPSHOT_ROOT="${PROXYPOOL_SNAPSHOT_ROOT:-/var/run/proxypool-config}"
PERSISTENT_STATE_DIR="${PROXYPOOL_PERSISTENT_STATE_DIR:-/etc/proxypool}"
ACTIVATED_BACKEND_MARKER="${PROXYPOOL_ACTIVATED_BACKEND_MARKER:-$PERSISTENT_STATE_DIR/activated-backend}"
CLEANUP_REQUIRED_MARKER="${PROXYPOOL_CLEANUP_REQUIRED_MARKER:-$PERSISTENT_STATE_DIR/cleanup-required}"
V2_RUNTIME_STATE="${PROXYPOOL_V2_RUNTIME_STATE:-$PERSISTENT_STATE_DIR/runtime-v2.json}"
DEFERRED_START_MARKER="${PROXYPOOL_DEFERRED_START_MARKER:-/var/run/proxypool.start-deferred}"

LEGACY_CONFIG_FILE="${PROXYPOOL_LEGACY_CONFIG_FILE:-${PROXYPOOL_CONFIG_FILE:-/etc/config/proxypool}}"
V2_CONFIG_FILE="${PROXYPOOL_V2_CONFIG_FILE:-/etc/config/proxypool_v2}"
SELECTOR_FILE="${PROXYPOOL_SELECTOR_FILE:-/etc/config/proxypool_runtime}"
CLASSIFIER="${PROXYPOOL_CLASSIFIER:-/usr/bin/proxypoolctl}"
LS_PROG="${PROXYPOOL_LS_PROG:-/bin/ls}"
FIREWALL_SAFETY_TEMPLATE="${PROXYPOOL_FIREWALL_SAFETY_TEMPLATE:-/usr/lib/proxypool/proxypool-safety-uci-default}"
FIREWALL_TRANSACTION_HELPER="${PROXYPOOL_FIREWALL_TRANSACTION_HELPER:-/usr/lib/proxypool/proxypool-firewall-transaction}"
FIREWALL_TRANSACTION_DIR="${PROXYPOOL_FIREWALL_TRANSACTION_DIR:-/etc/proxypool/firewall-transaction}"
LAN_ISOLATION_HELPER="${PROXYPOOL_LAN_ISOLATION:-/usr/lib/proxypool/lan-isolation.sh}"
LEGACY_GATE="${PROXYPOOL_LEGACY_GATE:-/usr/lib/proxypool/legacy-gate.sh}"

# Phase 1 deliberately blocks V1 <-> V2 transitions. V1 teardown currently
# removes its fail-closed network rules, so a cross-backend switch is unsafe
# until the backend-neutral baseline lands. Same-backend restart and fresh
# first activation remain transactional.
PROXYPOOL_PENDING_ACTION=
PROXYPOOL_PENDING_INSTANCE=
PROXYPOOL_PENDING_SNAPSHOT=
PROXYPOOL_PENDING_OLD_SNAPSHOT=
PROXYPOOL_START_RESULT=0
PROXYPOOL_STOP_CLEAN=0
PROXYPOOL_STOP_RESULT=0
PROXYPOOL_STOP_BACKEND=

PROXYPOOL_DESIRED_BACKEND=
PROXYPOOL_DESIRED_CLASS=
PROXYPOOL_DESIRED_ENABLED=
PROXYPOOL_DESIRED_SNAPSHOT=
PROXYPOOL_ACTIVATED_BACKEND=
PROXYPOOL_RUNTIME_BACKEND=
PROXYPOOL_NEEDS_ACTIVATION=0

legacy_quarantine() {
	/bin/sh "$LEGACY_GATE" mutation "$1" >/dev/null 2>&1 || true
	printf '%s\n' 'legacy_runtime_quarantined'
	return 125
}

legacy_start() {
	local sys_pid result
	legacy_quarantine 'init:legacy_start'
	result=$?
	[ "$result" -eq 0 ] || return "$result"

	if "$XL2TPD_INIT" enabled 2>/dev/null; then
		"$XL2TPD_INIT" stop 2>/dev/null
		"$XL2TPD_INIT" disable 2>/dev/null
	fi
	sys_pid=$(cat "$XL2TPD_PID" 2>/dev/null)
	if [ -n "$sys_pid" ] && kill -0 "$sys_pid" 2>/dev/null; then
		kill "$sys_pid" 2>/dev/null
		sleep 1
	fi
	v1_snapshot_matches_live || return 1

	echo "Starting ProxyPool V1..."
	"$PROG" start
	result=$?
	[ "$result" -eq 0 ] || return "$result"
	"$LEASE_PROG" boot 2>/dev/null

	sed -i "\|$WATCHDOG_PROG|d" "$CRONTAB_ROOT" 2>/dev/null
	sed -i "\|$LEASE_PROG|d" "$CRONTAB_ROOT" 2>/dev/null
	echo "* * * * * $WATCHDOG_PROG run" >>"$CRONTAB_ROOT"
	echo "*/5 * * * * $LEASE_PROG accrue" >>"$CRONTAB_ROOT"
	"$CRON_INIT" restart 2>/dev/null
	return 0
}

legacy_stop() {
	local result
	legacy_quarantine 'init:legacy_stop'
	result=$?
	[ "$result" -eq 0 ] || return "$result"
	# Disable every cron path that can resurrect V1 before its destructive
	# teardown. A partial edit or failed cron reload leaves V1 running and lets
	# the caller retain the cleanup WAL/quarantine for explicit recovery.
	sed -i "\|$WATCHDOG_PROG|d" "$CRONTAB_ROOT" 2>/dev/null || return 1
	sed -i "\|$LEASE_PROG|d" "$CRONTAB_ROOT" 2>/dev/null || return 1
	"$CRON_INIT" restart 2>/dev/null || return 1

	echo "Stopping ProxyPool V1..."
	"$PROG" stop
	result=$?
	if ! "$LEASE_PROG" flush 2>/dev/null; then
		[ "$result" -ne 0 ] || result=1
	fi
	return "$result"
}

legacy_reload() {
	local result
	legacy_quarantine 'init:legacy_reload'
	result=$?
	[ "$result" -eq 0 ] || return "$result"
	echo "Reloading ProxyPool V1..."
	"$PROG" reload
}

read_exact_backend_marker() {
	local marker_path="$1" allow_shadow="$2" recorded="" byte_count read_result
	if [ ! -e "$marker_path" ] && [ ! -L "$marker_path" ]; then
		return 0
	fi
	[ -f "$marker_path" ] && [ ! -L "$marker_path" ] && [ -r "$marker_path" ] || {
		printf '%s' corrupt
		return 0
	}
	byte_count=$(wc -c <"$marker_path" 2>/dev/null) || {
		printf '%s' corrupt
		return 0
	}
	if IFS= read -r recorded <"$marker_path"; then read_result=0; else read_result=$?; fi
	[ "$read_result" -eq 0 ] || {
		printf '%s' corrupt
		return 0
	}
	case "$recorded" in
		v1)
			[ "$byte_count" -eq 3 ] && printf '%s' v1 || printf '%s' corrupt
			;;
		v2_shadow)
			[ "$allow_shadow" = 1 ] && [ "$byte_count" -eq 10 ] && printf '%s' v2_shadow || printf '%s' corrupt
			;;
		*)
			printf '%s' corrupt
			;;
	esac
}

read_primary_backend() {
	read_exact_backend_marker "$RUNTIME_MARKER" 1
}

read_runtime_backend() {
	local primary
	primary=$(read_primary_backend)
	if [ -e "$QUARANTINE_MARKER" ] || [ -L "$QUARANTINE_MARKER" ] ||
		[ -e "$TRANSITION_MARKER" ] || [ -L "$TRANSITION_MARKER" ]; then
		printf '%s' corrupt
		return 0
	fi
	printf '%s' "$primary"
}

legacy_runtime_evidence_exists() {
	[ -e "$LEGACY_RUN_DIR" ] || [ -L "$LEGACY_RUN_DIR" ]
}

firewall_activation_precheck() {
	local journal_status
	# Every packaged lifecycle requires the immutable phase-1 template and the
	# runtime authority helper. Missing package evidence is corruption, never a
	# source-only compatibility signal.
	if [ ! -e "$FIREWALL_SAFETY_TEMPLATE" ] && [ ! -L "$FIREWALL_SAFETY_TEMPLATE" ]; then
		return 1
	fi
	[ -f "$FIREWALL_SAFETY_TEMPLATE" ] && [ ! -L "$FIREWALL_SAFETY_TEMPLATE" ] || return 1
	[ -f "$FIREWALL_TRANSACTION_HELPER" ] && [ ! -L "$FIREWALL_TRANSACTION_HELPER" ] &&
		[ -x "$FIREWALL_TRANSACTION_HELPER" ] || return 1
	persistent_path_secure "$FIREWALL_TRANSACTION_HELPER" '-rwxr-xr-x' 1 || return 1
	[ -f "$LAN_ISOLATION_HELPER" ] && [ ! -L "$LAN_ISOLATION_HELPER" ] &&
		[ -x "$LAN_ISOLATION_HELPER" ] || return 1
	# A durable journal always outranks an older activation marker.  Only the
	# helper's exact "absent" status (1) permits the hash-bound check; present,
	# corrupt, linked, or indeterminate journal evidence defers the backend.
	"$FIREWALL_TRANSACTION_HELPER" journal-present
	journal_status=$?
	[ "$journal_status" -eq 1 ] || return 1
	[ ! -e "$FIREWALL_TRANSACTION_DIR" ] && [ ! -L "$FIREWALL_TRANSACTION_DIR" ] || return 1
	# Authenticate the projection plus every nft/L2 contract byte and mode. This
	# precheck is read-only and therefore may run before backend classification.
	"$FIREWALL_TRANSACTION_HELPER" activation-current || return 1
	return 0
}

firewall_safety_ready() {
	# Repeat the read-only authority check at the mutation boundary so a journal
	# or package drift appearing after early admission cannot be missed.
	firewall_activation_precheck || return 1
	# The singleton procd worker owns every bridge mutation.  Admission is
	# strictly read-only and succeeds only after that worker has consumed all
	# pending/in-flight work and no wireless cold-reboot boundary remains.
	"$LAN_ISOLATION_HELPER" readiness || return 1
	# Revalidate both authority bytes and the live nft schema at the admission
	# boundary; this closes drift between the early precheck and backend start.
	"$FIREWALL_TRANSACTION_HELPER" activation-runtime-current
}

restart() {
	local result=0 admission
	if ! firewall_activation_precheck; then
		echo 'ProxyPool restart blocked: firewall safety activation is not current' >&2
		return 1
	fi
	require_nonlegacy_lifecycle 'init:restart'
	admission=$?
	[ "$admission" -eq 0 ] || return "$admission"
	# OpenWrt rc.common normally stops first and checks start admission later.
	# That ordering can strand a running backend after safety authority was lost,
	# so restart performs the shared gate before its destructive stop half.
	if ! firewall_safety_ready; then
		echo 'ProxyPool restart blocked: firewall/L2 safety activation is not current' >&2
		return 1
	fi
	trap '' TERM
	stop "$@" || result=$?
	trap - TERM
	[ "$result" -eq 0 ] || return "$result"
	start "$@"
}

persistent_path_secure() {
	local path="$1" expected_permissions="$2" expected_links="${3-}" metadata permissions links owner group remainder
	metadata=$("$LS_PROG" -nd "$path" 2>/dev/null) || return 1
	case "$metadata" in
		""|*'
'*) return 1 ;;
	esac
	IFS=' 	' read -r permissions links owner group remainder <<EOF
$metadata
EOF
	[ "$permissions" = "$expected_permissions" ] || return 1
	case "$links" in ""|*[!0-9]*) return 1 ;; esac
	[ -z "$expected_links" ] || [ "$links" = "$expected_links" ] || return 1
	[ "$owner" = 0 ] && [ "$group" = 0 ] || return 1
}

persistent_layout_valid() {
	local marker
	[ "${ACTIVATED_BACKEND_MARKER%/*}" = "$PERSISTENT_STATE_DIR" ] || return 1
	[ "${CLEANUP_REQUIRED_MARKER%/*}" = "$PERSISTENT_STATE_DIR" ] || return 1
	if [ -e "$PERSISTENT_STATE_DIR" ] || [ -L "$PERSISTENT_STATE_DIR" ]; then
		[ -d "$PERSISTENT_STATE_DIR" ] && [ ! -L "$PERSISTENT_STATE_DIR" ] || return 1
		persistent_path_secure "$PERSISTENT_STATE_DIR" 'drwx------' || return 1
	fi
	for marker in "$ACTIVATED_BACKEND_MARKER" "$CLEANUP_REQUIRED_MARKER"; do
		if [ -e "$marker" ] || [ -L "$marker" ]; then
			[ -f "$marker" ] && [ ! -L "$marker" ] || return 1
			persistent_path_secure "$marker" '-rw-------' 1 || return 1
		fi
	done
	return 0
}

read_activated_backend() {
	persistent_layout_valid || {
		printf '%s' corrupt
		return 0
	}
	read_exact_backend_marker "$ACTIVATED_BACKEND_MARKER" 1
}

read_cleanup_required() {
	persistent_layout_valid || {
		printf '%s' corrupt
		return 0
	}
	read_exact_backend_marker "$CLEANUP_REQUIRED_MARKER" 1
}

write_line_atomically() {
	local destination="$1" value="$2" temporary
	if [ -e "$destination" ] || [ -L "$destination" ]; then
		[ -f "$destination" ] && [ ! -L "$destination" ] || return 1
	fi
	temporary="${destination}.$$"
	(umask 077 && printf '%s\n' "$value" >"$temporary") || {
		rm -f "$temporary"
		return 1
	}
	mv -f "$temporary" "$destination" || {
		rm -f "$temporary"
		return 1
	}
}

publish_deferred_start() {
	case "$DEFERRED_START_MARKER" in
		/*) : ;;
		*) return 1 ;;
	esac
	[ "$DEFERRED_START_MARKER" != / ] || return 1
	write_line_atomically "$DEFERRED_START_MARKER" pending || return 1
	chmod 600 "$DEFERRED_START_MARKER" || return 1
}

clear_deferred_start() {
	case "$DEFERRED_START_MARKER" in
		/*) : ;;
		*) return 1 ;;
	esac
	[ "$DEFERRED_START_MARKER" != / ] || return 1
	if [ ! -e "$DEFERRED_START_MARKER" ] && [ ! -L "$DEFERRED_START_MARKER" ]; then
		return 0
	fi
	[ -f "$DEFERRED_START_MARKER" ] && [ ! -L "$DEFERRED_START_MARKER" ] || return 1
	rm -f "$DEFERRED_START_MARKER" || return 1
	[ ! -e "$DEFERRED_START_MARKER" ] && [ ! -L "$DEFERRED_START_MARKER" ]
}

ensure_persistent_state_dir() {
	persistent_layout_valid || return 1
	if [ ! -e "$PERSISTENT_STATE_DIR" ]; then
		mkdir -p "$PERSISTENT_STATE_DIR" || return 1
	fi
	[ -d "$PERSISTENT_STATE_DIR" ] && [ ! -L "$PERSISTENT_STATE_DIR" ] || return 1
	chmod 700 "$PERSISTENT_STATE_DIR" || return 1
	persistent_layout_valid
}

write_persistent_backend() {
	local destination="$1" backend="$2"
	ensure_persistent_state_dir || return 1
	write_line_atomically "$destination" "$backend" || return 1
	chmod 600 "$destination" || return 1
	persistent_layout_valid
}

write_activated_backend() {
	write_persistent_backend "$ACTIVATED_BACKEND_MARKER" "$1"
}

write_cleanup_required() {
	write_persistent_backend "$CLEANUP_REQUIRED_MARKER" "$1"
}

clear_cleanup_required() {
	local recorded
	recorded=$(read_cleanup_required)
	[ "$recorded" = "$1" ] || return 1
	rm -f "$CLEANUP_REQUIRED_MARKER" || return 1
	[ ! -e "$CLEANUP_REQUIRED_MARKER" ] && [ ! -L "$CLEANUP_REQUIRED_MARKER" ]
}

write_runtime_backend() {
	write_line_atomically "$RUNTIME_MARKER" "$1"
}

write_quarantine_backend() {
	write_line_atomically "$QUARANTINE_MARKER" "$1"
}

record_v1_cleanup_required() {
	write_quarantine_backend v1 || write_runtime_backend v1 || true
}

clear_backend_evidence() {
	rm -f "$RUNTIME_MARKER" "$QUARANTINE_MARKER" "$TRANSITION_MARKER" "$ACTIVE_SNAPSHOT_MARKER"
}

is_managed_snapshot_path() {
	local snapshot="$1" parent base
	[ -n "$snapshot" ] || return 1
	[ -d "$SNAPSHOT_ROOT" ] && [ ! -L "$SNAPSHOT_ROOT" ] || return 1
	parent=${snapshot%/*}
	base=${snapshot##*/}
	[ "$parent" = "$SNAPSHOT_ROOT" ] || return 1
	case "$base" in
		generation.[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9]) return 0 ;;
		*) return 1 ;;
	esac
}

discard_managed_snapshot() {
	local snapshot="$1"
	is_managed_snapshot_path "$snapshot" || return 1
	[ ! -L "$snapshot" ] || return 1
	if [ -e "$snapshot" ]; then
		[ -d "$snapshot" ] || return 1
		rm -rf "$snapshot" || return 1
	fi
	return 0
}

discard_desired_snapshot() {
	local snapshot="$PROXYPOOL_DESIRED_SNAPSHOT"
	PROXYPOOL_DESIRED_SNAPSHOT=
	[ -z "$snapshot" ] || discard_managed_snapshot "$snapshot" || true
}

read_active_snapshot_pointer() {
	local recorded byte_count read_result
	if [ ! -e "$ACTIVE_SNAPSHOT_MARKER" ] && [ ! -L "$ACTIVE_SNAPSHOT_MARKER" ]; then
		return 0
	fi
	[ -f "$ACTIVE_SNAPSHOT_MARKER" ] && [ ! -L "$ACTIVE_SNAPSHOT_MARKER" ] && [ -r "$ACTIVE_SNAPSHOT_MARKER" ] || return 0
	byte_count=$(wc -c <"$ACTIVE_SNAPSHOT_MARKER" 2>/dev/null) || return 0
	if IFS= read -r recorded <"$ACTIVE_SNAPSHOT_MARKER"; then read_result=0; else read_result=$?; fi
	[ "$read_result" -eq 0 ] || return 0
	[ "$byte_count" -eq $((${#recorded} + 1)) ] || return 0
	is_managed_snapshot_path "$recorded" || return 0
	[ -d "$recorded" ] && [ ! -L "$recorded" ] || return 0
	[ -f "$recorded/proxypool" ] && [ ! -L "$recorded/proxypool" ] || return 0
	printf '%s' "$recorded"
}

sweep_managed_snapshots() {
	local snapshot result=0
	if [ ! -e "$SNAPSHOT_ROOT" ] && [ ! -L "$SNAPSHOT_ROOT" ]; then
		return 0
	fi
	[ -d "$SNAPSHOT_ROOT" ] && [ ! -L "$SNAPSHOT_ROOT" ] || return 1
	for snapshot in "$SNAPSHOT_ROOT"/generation.*; do
		[ -e "$snapshot" ] || [ -L "$snapshot" ] || continue
		discard_managed_snapshot "$snapshot" || result=1
	done
	return "$result"
}

clear_backend_evidence_and_snapshots() {
	local result=0
	clear_backend_evidence || result=1
	sweep_managed_snapshots || result=1
	return "$result"
}

capture_selector() {
	local output result sentinel=':proxypool-selector-end'
	output=$(
		"$CLASSIFIER" select-backend --config "$1" 2>/dev/null
		result=$?
		[ "$result" -eq 0 ] || exit "$result"
		printf '%s' "$sentinel"
	)
	result=$?
	[ "$result" -eq 0 ] || return 1
	case "$output" in
		"missing
$sentinel") printf '%s' missing ;;
		"v1
$sentinel") printf '%s' v1 ;;
		"v2_shadow
$sentinel") printf '%s' v2_shadow ;;
		*) return 1 ;;
	esac
}

# Read-only lifecycle admission. Existing ownership outranks the current
# selector, so a V2 service can still be stopped after a bad configuration
# edit, while any V1 ownership remains quarantined. No snapshots, journals,
# firewall reconciliation, cron edits, or procd calls occur in this function.
initial_backend_owner() {
	local cleanup activated runtime quarantine selection owner= marker
	cleanup=$(read_cleanup_required)
	activated=$(read_activated_backend)
	runtime=$(read_primary_backend)
	quarantine=$(read_exact_backend_marker "$QUARANTINE_MARKER" 0)

	for marker in "$cleanup" "$activated" "$runtime" "$quarantine"; do
		case "$marker" in
			corrupt) return 1 ;;
			v1|v2_shadow)
				if [ -n "$owner" ] && [ "$owner" != "$marker" ]; then
					return 1
				fi
				owner=$marker
				;;
			"") ;;
			*) return 1 ;;
		esac
	done
	if [ -e "$TRANSITION_MARKER" ] || [ -L "$TRANSITION_MARKER" ]; then
		return 1
	fi
	if [ -n "$owner" ]; then
		printf '%s' "$owner"
		return 0
	fi

	selection=$(capture_selector "$SELECTOR_FILE") || return 1
	case "$selection" in
		missing|v1) printf '%s' v1 ;;
		v2_shadow) printf '%s' v2_shadow ;;
		*) return 1 ;;
	esac
}

require_nonlegacy_lifecycle() {
	local scope=$1 owner result
	owner=$(initial_backend_owner)
	result=$?
	[ "$result" -eq 0 ] || return "$result"
	case "$owner" in
		v2_shadow) return 0 ;;
		v1)
			legacy_quarantine "$scope"
			return $?
			;;
		*) return 1 ;;
	esac
}

capture_classification() {
	local output result sentinel=':proxypool-classification-end'
	output=$(
		"$CLASSIFIER" classify --config "$1" 2>/dev/null
		result=$?
		[ "$result" -eq 0 ] || exit "$result"
		printf '%s' "$sentinel"
	)
	result=$?
	[ "$result" -eq 0 ] || return 1
	case "$output" in
		"v1
$sentinel") printf '%s' v1 ;;
		"v2_shadow
$sentinel") printf '%s' v2_shadow ;;
		"v2_shadow_invalid
$sentinel") printf '%s' v2_shadow_invalid ;;
		*) return 1 ;;
	esac
}

capture_enabled() {
	local output result sentinel=':proxypool-enabled-end'
	output=$(
		"$CLASSIFIER" config-enabled --config "$1" 2>/dev/null
		result=$?
		[ "$result" -eq 0 ] || exit "$result"
		printf '%s' "$sentinel"
	)
	result=$?
	[ "$result" -eq 0 ] || return 1
	case "$output" in
		"0
$sentinel") printf '%s' 0 ;;
		"1
$sentinel") printf '%s' 1 ;;
		*) return 1 ;;
	esac
}

capture_procd_state() {
	local instance="${1-}" output result sentinel=':proxypool-procd-state-end'
	if [ -n "$instance" ]; then
		output=$(
			"$CLASSIFIER" procd-state --service proxypool --instance "$instance" 2>/dev/null
			result=$?
			[ "$result" -eq 0 ] || exit "$result"
			printf '%s' "$sentinel"
		)
	else
		output=$(
			"$CLASSIFIER" procd-state --service proxypool 2>/dev/null
			result=$?
			[ "$result" -eq 0 ] || exit "$result"
			printf '%s' "$sentinel"
		)
	fi
	result=$?
	[ "$result" -eq 0 ] || {
		printf '%s' unknown
		return 0
	}
	case "$output" in
		"running
$sentinel") [ -n "$instance" ] && printf '%s' running || printf '%s' unknown ;;
		"present
$sentinel") printf '%s' present ;;
		"absent
$sentinel") printf '%s' absent ;;
		*) printf '%s' unknown ;;
	esac
}

new_snapshot_dir() {
	if [ -e "$SNAPSHOT_ROOT" ] || [ -L "$SNAPSHOT_ROOT" ]; then
		[ -d "$SNAPSHOT_ROOT" ] && [ ! -L "$SNAPSHOT_ROOT" ] || return 1
	else
		mkdir -p "$SNAPSHOT_ROOT" || return 1
	fi
	chmod 700 "$SNAPSHOT_ROOT" || return 1
	mktemp -d "$SNAPSHOT_ROOT/generation.XXXXXX"
}

build_desired_snapshot() {
	local snapshot selector_copy selection source classification enabled
	PROXYPOOL_DESIRED_BACKEND=
	PROXYPOOL_DESIRED_CLASS=
	PROXYPOOL_DESIRED_ENABLED=
	PROXYPOOL_DESIRED_SNAPSHOT=
	snapshot=$(new_snapshot_dir) || return 1
	PROXYPOOL_DESIRED_SNAPSHOT="$snapshot"
	chmod 700 "$snapshot" || {
		discard_desired_snapshot
		return 1
	}
	selector_copy="$snapshot/proxypool_runtime"
	if [ -e "$SELECTOR_FILE" ] || [ -L "$SELECTOR_FILE" ]; then
		[ -f "$SELECTOR_FILE" ] && [ ! -L "$SELECTOR_FILE" ] || {
			discard_desired_snapshot
			return 1
		}
		(umask 077 && cp "$SELECTOR_FILE" "$selector_copy") || {
			discard_desired_snapshot
			return 1
		}
	fi
	selection=$(capture_selector "$selector_copy") || {
		discard_desired_snapshot
		return 1
	}
	case "$selection" in
		missing|v1) source="$LEGACY_CONFIG_FILE" ;;
		v2_shadow) source="$V2_CONFIG_FILE" ;;
		*)
			discard_desired_snapshot
			return 1
			;;
	esac
	[ -f "$source" ] && [ ! -L "$source" ] || {
		discard_desired_snapshot
		return 1
	}
	(umask 077 && cp "$source" "$snapshot/proxypool") || {
		discard_desired_snapshot
		return 1
	}
	chmod 600 "$snapshot/proxypool" || {
		discard_desired_snapshot
		return 1
	}
	classification=$(capture_classification "$snapshot/proxypool") || {
		discard_desired_snapshot
		return 1
	}
	case "$selection:$classification" in
		missing:v1|v1:v1)
			PROXYPOOL_DESIRED_BACKEND=v1
			;;
		v2_shadow:v2_shadow|v2_shadow:v2_shadow_invalid)
			PROXYPOOL_DESIRED_BACKEND=v2_shadow
			;;
		*)
			discard_desired_snapshot
			return 1
			;;
	esac
	if [ "$classification" = v2_shadow_invalid ]; then
		enabled=1
	else
		enabled=$(capture_enabled "$snapshot/proxypool") || {
			discard_desired_snapshot
			return 1
		}
	fi
	PROXYPOOL_DESIRED_CLASS="$classification"
	PROXYPOOL_DESIRED_ENABLED="$enabled"
	PROXYPOOL_DESIRED_SNAPSHOT="$snapshot"
}

build_v1_snapshot() {
	local snapshot classification enabled
	PROXYPOOL_DESIRED_BACKEND=
	PROXYPOOL_DESIRED_CLASS=
	PROXYPOOL_DESIRED_ENABLED=
	PROXYPOOL_DESIRED_SNAPSHOT=
	snapshot=$(new_snapshot_dir) || return 1
	PROXYPOOL_DESIRED_SNAPSHOT="$snapshot"
	chmod 700 "$snapshot" || {
		discard_desired_snapshot
		return 1
	}
	[ -f "$LEGACY_CONFIG_FILE" ] && [ ! -L "$LEGACY_CONFIG_FILE" ] || {
		discard_desired_snapshot
		return 1
	}
	(umask 077 && cp "$LEGACY_CONFIG_FILE" "$snapshot/proxypool") || {
		discard_desired_snapshot
		return 1
	}
	chmod 600 "$snapshot/proxypool" || {
		discard_desired_snapshot
		return 1
	}
	classification=$(capture_classification "$snapshot/proxypool") || {
		discard_desired_snapshot
		return 1
	}
	[ "$classification" = v1 ] || {
		discard_desired_snapshot
		return 1
	}
	enabled=$(capture_enabled "$snapshot/proxypool") || {
		discard_desired_snapshot
		return 1
	}
	PROXYPOOL_DESIRED_BACKEND=v1
	PROXYPOOL_DESIRED_CLASS=v1
	PROXYPOOL_DESIRED_ENABLED="$enabled"
	PROXYPOOL_DESIRED_SNAPSHOT="$snapshot"
}

v1_snapshot_matches_live() {
	[ "$PROXYPOOL_DESIRED_BACKEND" = v1 ] || return 1
	is_managed_snapshot_path "$PROXYPOOL_DESIRED_SNAPSHOT" || return 1
	[ -f "$PROXYPOOL_DESIRED_SNAPSHOT/proxypool" ] && [ ! -L "$PROXYPOOL_DESIRED_SNAPSHOT/proxypool" ] || return 1
	[ -f "$LEGACY_CONFIG_FILE" ] && [ ! -L "$LEGACY_CONFIG_FILE" ] || return 1
	cmp -s "$PROXYPOOL_DESIRED_SNAPSHOT/proxypool" "$LEGACY_CONFIG_FILE"
}

inspect_normal_backend_evidence() {
	local cleanup activated runtime
	PROXYPOOL_ACTIVATED_BACKEND=
	PROXYPOOL_RUNTIME_BACKEND=
	PROXYPOOL_NEEDS_ACTIVATION=0
	cleanup=$(read_cleanup_required)
	[ -z "$cleanup" ] || return 1
	activated=$(read_activated_backend)
	runtime=$(read_runtime_backend)
	[ "$activated" != corrupt ] && [ "$runtime" != corrupt ] || return 1
	case "$activated" in
		"")
			[ "$PROXYPOOL_DESIRED_BACKEND" = v1 ] || return 1
			PROXYPOOL_NEEDS_ACTIVATION=1
			;;
		v1|v2_shadow)
			[ "$activated" = "$PROXYPOOL_DESIRED_BACKEND" ] || return 1
			;;
		*) return 1 ;;
	esac
	if [ -n "$runtime" ]; then
		[ "$runtime" = "$PROXYPOOL_DESIRED_BACKEND" ] || return 1
	fi
	PROXYPOOL_ACTIVATED_BACKEND="${activated:-$PROXYPOOL_DESIRED_BACKEND}"
	PROXYPOOL_RUNTIME_BACKEND="$runtime"
	return 0
}

reserve_desired_activation() {
	if [ "$PROXYPOOL_NEEDS_ACTIVATION" = 1 ]; then
		[ "$PROXYPOOL_DESIRED_BACKEND" = v1 ] || return 1
		write_activated_backend v1 || return 1
		PROXYPOOL_ACTIVATED_BACKEND=v1
		PROXYPOOL_NEEDS_ACTIVATION=0
	fi
	return 0
}

begin_backend_mutation() {
	reserve_desired_activation || return 1
	write_cleanup_required "$PROXYPOOL_ACTIVATED_BACKEND"
}

finish_confirmed_cleanup() {
	local backend="$1"
	clear_backend_evidence_and_snapshots || return 1
	clear_cleanup_required "$backend"
}

shadow_instance_for_snapshot() {
	local snapshot="$1" suffix
	suffix=${snapshot##*.}
	printf 'shadow-%s-%s' "$$" "$suffix"
}

start_shadow() {
	local snapshot="$1" instance="$2"
	[ -f "$V2_CONFIG_FILE" ] && [ ! -L "$V2_CONFIG_FILE" ] &&
		cmp -s "$snapshot/proxypool" "$V2_CONFIG_FILE" || return 1
	procd_open_instance "$instance" || return 1
	procd_set_param command /usr/sbin/proxypoold --config "$V2_CONFIG_FILE" --state "$V2_RUNTIME_STATE" --socket /var/run/proxypoold.sock --live || return 1
	procd_set_param respawn 3600 5 5 || return 1
	procd_set_param stdout 1 || return 1
	procd_set_param stderr 1 || return 1
	procd_close_instance || return 1
}

load_prepared_start() {
	[ "${PROXYPOOL_START_PREPARED:-0}" = 1 ] || return 1
	PROXYPOOL_DESIRED_BACKEND="$PROXYPOOL_START_BACKEND"
	PROXYPOOL_DESIRED_CLASS="$PROXYPOOL_START_CLASS"
	PROXYPOOL_DESIRED_ENABLED="$PROXYPOOL_START_ENABLED"
	PROXYPOOL_DESIRED_SNAPSHOT="$PROXYPOOL_START_SNAPSHOT"
	PROXYPOOL_START_PREPARED=0
	PROXYPOOL_START_SNAPSHOT=
	return 0
}

start_service() {
	local previous result instance preflight_state backend admission
	if ! firewall_activation_precheck; then
		echo 'ProxyPool start deferred: firewall safety activation is not current' >&2
		publish_deferred_start || exit 1
		exit 0
	fi
	require_nonlegacy_lifecycle 'init:start'
	admission=$?
	[ "$admission" -eq 0 ] || exit "$admission"
	if ! firewall_safety_ready; then
		echo 'ProxyPool start deferred: firewall safety activation is not current' >&2
		# rc.common would otherwise close/send an empty procd service-set after a
		# normal return.  Exit the one-shot action before any backend or procd
		# mutation; S19/runtime finalization makes a later start admissible.
		publish_deferred_start || exit 1
		exit 0
	fi
	PROXYPOOL_PENDING_ACTION=
	PROXYPOOL_PENDING_INSTANCE=
	PROXYPOOL_PENDING_SNAPSHOT=
	PROXYPOOL_PENDING_OLD_SNAPSHOT=
	PROXYPOOL_START_RESULT=0

	if ! load_prepared_start && ! build_desired_snapshot; then
		echo 'ProxyPool start blocked: selector/config snapshot is invalid' >&2
		# rc.common always sends the open service-set even when this function
		# returns nonzero. Exiting the one-shot init process is the only way to
		# abort before that send and keep the existing procd state untouched.
		exit 1
	fi
	if ! inspect_normal_backend_evidence; then
		echo 'ProxyPool start blocked: persistent or runtime evidence is inconsistent' >&2
		discard_desired_snapshot
		exit 1
	fi
	previous="$PROXYPOOL_RUNTIME_BACKEND"
	backend="$PROXYPOOL_ACTIVATED_BACKEND"
	if [ "$backend" = v2_shadow ] && legacy_runtime_evidence_exists; then
		echo 'ProxyPool fresh V2 start blocked: legacy runtime evidence exists' >&2
		discard_desired_snapshot
		exit 1
	fi

	# Direct ubus inspection is independent of procd.sh's open JSON document.
	# Unknown state aborts the transaction before procd_close_service. V1 may
	# start only after global absence; an unmarked fresh activation also
	# requires absence so it never overwrites an unexplained service.
	preflight_state=$(capture_procd_state)
	[ "$preflight_state" != unknown ] || {
		echo 'ProxyPool start blocked: procd state is unknown' >&2
		discard_desired_snapshot
		exit 1
	}
	if [ "$PROXYPOOL_DESIRED_BACKEND" = v1 ] && [ "$preflight_state" != absent ]; then
		echo 'ProxyPool V1 start blocked: a procd instance is still present' >&2
		discard_desired_snapshot
		exit 1
	fi
	if [ -z "$previous" ] && [ "$preflight_state" != absent ]; then
		echo 'ProxyPool fresh start blocked: an unrecorded procd instance is present' >&2
		discard_desired_snapshot
		exit 1
	fi
	if [ "$PROXYPOOL_DESIRED_ENABLED" = 0 ] && [ "$PROXYPOOL_NEEDS_ACTIVATION" = 1 ] &&
		[ -z "$previous" ] && [ ! -d "$LEGACY_RUN_DIR" ]; then
		reserve_desired_activation || {
			discard_desired_snapshot
			exit 1
		}
		discard_desired_snapshot
		# Exiting the one-shot action with success prevents rc.common from
		# sending an empty service-set for a backend that never ran.
		exit 0
	fi
	if ! begin_backend_mutation; then
		echo 'ProxyPool start blocked: persistent transaction evidence is unavailable' >&2
		discard_desired_snapshot
		exit 1
	fi
	backend="$PROXYPOOL_ACTIVATED_BACKEND"
	if [ "$backend" = v1 ] && ! v1_snapshot_matches_live; then
		discard_desired_snapshot
		clear_cleanup_required v1 || true
		echo 'ProxyPool V1 start blocked: live config changed during admission' >&2
		exit 1
	fi

	if [ "$PROXYPOOL_DESIRED_ENABLED" = 0 ]; then
		if [ "$backend" = v1 ] && { [ "$previous" = v1 ] || [ -d "$LEGACY_RUN_DIR" ]; }; then
			if ! v1_snapshot_matches_live || ! legacy_stop; then
				record_v1_cleanup_required
				discard_desired_snapshot
				exit 1
			fi
		fi
		discard_desired_snapshot
		PROXYPOOL_PENDING_ACTION=disable
		return 0
	fi

	case "$PROXYPOOL_DESIRED_BACKEND" in
		v1)
			if [ "$previous" = v1 ] || { [ -z "$previous" ] && [ -d "$LEGACY_RUN_DIR" ]; }; then
				if ! v1_snapshot_matches_live || ! legacy_stop; then
					record_v1_cleanup_required
					discard_desired_snapshot
					exit 1
				fi
			fi
			PROXYPOOL_PENDING_ACTION=start_v1
			PROXYPOOL_PENDING_SNAPSHOT="$PROXYPOOL_DESIRED_SNAPSHOT"
			PROXYPOOL_DESIRED_SNAPSHOT=
			;;
		v2_shadow)
			PROXYPOOL_PENDING_OLD_SNAPSHOT=$(read_active_snapshot_pointer)
			instance=$(shadow_instance_for_snapshot "$PROXYPOOL_DESIRED_SNAPSHOT")
			start_shadow "$PROXYPOOL_DESIRED_SNAPSHOT" "$instance"
			result=$?
			PROXYPOOL_PENDING_ACTION=start_v2
			PROXYPOOL_PENDING_INSTANCE="$instance"
			PROXYPOOL_PENDING_SNAPSHOT="$PROXYPOOL_DESIRED_SNAPSHOT"
			PROXYPOOL_DESIRED_SNAPSHOT=
			if [ "$result" -ne 0 ]; then
				PROXYPOOL_START_RESULT="$result"
				return "$result"
			fi
			;;
	esac
}

service_started() {
	local pending="$PROXYPOOL_PENDING_ACTION"
	local result="$PROXYPOOL_START_RESULT" state rollback_result
	local instance="$PROXYPOOL_PENDING_INSTANCE"
	local snapshot="$PROXYPOOL_PENDING_SNAPSHOT"
	local old_snapshot="$PROXYPOOL_PENDING_OLD_SNAPSHOT"
	local backend="$PROXYPOOL_ACTIVATED_BACKEND"
	PROXYPOOL_PENDING_ACTION=
	PROXYPOOL_PENDING_INSTANCE=
	PROXYPOOL_PENDING_SNAPSHOT=
	PROXYPOOL_PENDING_OLD_SNAPSHOT=
	PROXYPOOL_START_RESULT=0

	if [ "$result" -ne 0 ]; then
		procd_kill proxypool || true
		# Never use the procd_kill return code as evidence. A failed or
		# malformed status query leaves all existing markers untouched.
		state=$(capture_procd_state)
		[ "$state" = absent ] || return "$result"
		if [ "$pending" = start_v2 ]; then
			finish_confirmed_cleanup v2_shadow || true
		else
			[ -z "$snapshot" ] || discard_managed_snapshot "$snapshot" || true
		fi
		return "$result"
	fi

	case "$pending" in
		disable)
		state=$(capture_procd_state)
		[ "$state" = absent ] || return 1
		finish_confirmed_cleanup "$backend" || return 1
		;;
		start_v1)
		state=$(capture_procd_state)
		[ "$state" = absent ] || return 1
		PROXYPOOL_DESIRED_BACKEND=v1
		PROXYPOOL_DESIRED_SNAPSHOT="$snapshot"
		if ! v1_snapshot_matches_live; then
			discard_desired_snapshot
			finish_confirmed_cleanup v1 || true
			return 1
		fi
		if legacy_start; then result=0; else result=$?; fi
		if [ "$result" -ne 0 ]; then
			if ! v1_snapshot_matches_live; then
				record_v1_cleanup_required
				discard_desired_snapshot
				return "$result"
			fi
			if legacy_stop; then rollback_result=0; else rollback_result=$?; fi
			if [ "$rollback_result" -ne 0 ]; then
				record_v1_cleanup_required
				discard_desired_snapshot
				return "$result"
			fi
			discard_desired_snapshot
			finish_confirmed_cleanup v1 || true
			return "$result"
		fi
		if ! write_runtime_backend v1; then
			if ! v1_snapshot_matches_live || ! legacy_stop; then
				record_v1_cleanup_required
				discard_desired_snapshot
				return 1
			fi
			discard_desired_snapshot
			finish_confirmed_cleanup v1 || true
			return 1
		fi
		discard_desired_snapshot
		rm -f "$QUARANTINE_MARKER" "$TRANSITION_MARKER" "$ACTIVE_SNAPSHOT_MARKER" || return 1
		clear_cleanup_required v1 || return 1
		;;
		start_v2)
			state=$(capture_procd_state "$instance")
			if [ "$state" != running ]; then
				[ "$state" != unknown ] || return 1
				procd_kill proxypool || true
				state=$(capture_procd_state)
				[ "$state" = absent ] || return 1
				finish_confirmed_cleanup v2_shadow || true
				return 1
			fi
			if ! write_runtime_backend v2_shadow; then
				procd_kill proxypool || true
				state=$(capture_procd_state)
				if [ "$state" = absent ]; then
					finish_confirmed_cleanup v2_shadow || true
				fi
				return 1
			fi
			if write_line_atomically "$ACTIVE_SNAPSHOT_MARKER" "$snapshot"; then
				if [ -n "$old_snapshot" ] && [ "$old_snapshot" != "$snapshot" ]; then
					discard_managed_snapshot "$old_snapshot" || true
				fi
			fi
			rm -f "$QUARANTINE_MARKER" "$TRANSITION_MARKER" || return 1
			clear_cleanup_required v2_shadow || return 1
		;;
		*)
			return 1
			;;
	esac
	clear_deferred_start || return 1
	return 0
}

stop_service() {
	local activated cleanup runtime backend result state recovery=0 admission
	# An explicit stop/disable cancels an earlier boot-time retry request before
	# inspecting backend state, so the LAN worker cannot resurrect the service.
	clear_deferred_start || exit 1
	require_nonlegacy_lifecycle 'init:stop'
	admission=$?
	[ "$admission" -eq 0 ] || exit "$admission"
	PROXYPOOL_STOP_CLEAN=0
	PROXYPOOL_STOP_RESULT=0
	PROXYPOOL_STOP_BACKEND=
	cleanup=$(read_cleanup_required)
	activated=$(read_activated_backend)
	case "$cleanup" in
		corrupt)
			echo 'ProxyPool stop blocked: cleanup evidence is invalid' >&2
			exit 1
			;;
		v1|v2_shadow)
			[ "$activated" = "$cleanup" ] || {
				echo 'ProxyPool stop blocked: cleanup ownership is inconsistent' >&2
				exit 1
			}
			runtime=$(read_primary_backend)
			[ "$runtime" != corrupt ] && { [ -z "$runtime" ] || [ "$runtime" = "$activated" ]; } || {
				echo 'ProxyPool stop blocked: runtime ownership is inconsistent' >&2
				exit 1
			}
			backend="$activated"
			recovery=1
			if [ "$backend" = v1 ]; then
				state=$(capture_procd_state)
				[ "$state" = absent ] || {
					echo 'ProxyPool V1 recovery blocked: conflicting procd evidence exists' >&2
					exit 1
				}
				build_v1_snapshot || {
					echo 'ProxyPool V1 recovery blocked: live config is not strict V1' >&2
					exit 1
				}
			elif legacy_runtime_evidence_exists; then
				echo 'ProxyPool V2 recovery blocked: conflicting legacy runtime evidence exists' >&2
				exit 1
			fi
			;;
		"")
			build_desired_snapshot || {
				echo 'ProxyPool stop blocked: selector/config snapshot is invalid' >&2
				exit 1
			}
			inspect_normal_backend_evidence || {
				discard_desired_snapshot
				echo 'ProxyPool stop blocked: persistent or runtime evidence is inconsistent' >&2
				exit 1
			}
			backend="$PROXYPOOL_ACTIVATED_BACKEND"
			case "$backend" in
				v1)
					state=$(capture_procd_state)
					[ "$state" = absent ] || {
						discard_desired_snapshot
						echo 'ProxyPool V1 stop blocked: conflicting procd evidence exists' >&2
						exit 1
					}
					;;
				v2_shadow)
					if legacy_runtime_evidence_exists; then
						discard_desired_snapshot
						echo 'ProxyPool stop blocked: conflicting legacy runtime evidence exists' >&2
						exit 1
					fi
					;;
			esac
			begin_backend_mutation || {
				discard_desired_snapshot
				echo 'ProxyPool stop blocked: persistent transaction evidence is unavailable' >&2
				exit 1
			}
			;;
		*)
			echo 'ProxyPool stop blocked: cleanup evidence is invalid' >&2
			exit 1
			;;
	esac
	PROXYPOOL_STOP_BACKEND="$backend"
	case "$backend" in
		v1)
			if ! v1_snapshot_matches_live; then
				discard_desired_snapshot
				[ "$recovery" = 1 ] || clear_cleanup_required v1 || true
				echo 'ProxyPool V1 stop blocked: live config changed during admission' >&2
				exit 1
			fi
			if legacy_stop; then
				:
			else
				result=$?
				record_v1_cleanup_required
				discard_desired_snapshot
				PROXYPOOL_STOP_RESULT="$result"
				return "$result"
			fi
			discard_desired_snapshot
			;;
		v2_shadow)
			# rc.common performs the procd teardown after this hook.
			discard_desired_snapshot
			;;
		*)
			exit 1
			;;
	esac
	PROXYPOOL_STOP_CLEAN=1
}

service_stopped() {
	local state result="$PROXYPOOL_STOP_RESULT" backend="$PROXYPOOL_STOP_BACKEND"
	if [ "$PROXYPOOL_STOP_CLEAN" = 1 ]; then
		state=$(capture_procd_state)
		if [ "$state" = absent ]; then
			if ! finish_confirmed_cleanup "$backend" && [ "$result" -eq 0 ]; then
				result=1
			fi
		elif [ "$result" -eq 0 ]; then
			result=1
		fi
	fi
	PROXYPOOL_STOP_CLEAN=0
	PROXYPOOL_STOP_RESULT=0
	PROXYPOOL_STOP_BACKEND=
	return "$result"
}

reload_service() {
	local previous state result backend admission
	if ! firewall_activation_precheck; then
		echo 'ProxyPool reload blocked: firewall safety activation is not current' >&2
		return 1
	fi
	require_nonlegacy_lifecycle 'init:reload'
	admission=$?
	[ "$admission" -eq 0 ] || return "$admission"
	if ! firewall_safety_ready; then
		echo 'ProxyPool reload blocked: firewall/L2 safety activation is not current' >&2
		return 1
	fi
	build_desired_snapshot || {
		echo 'ProxyPool reload blocked: selector/config snapshot is invalid' >&2
		return 1
	}
	if ! inspect_normal_backend_evidence; then
		echo 'ProxyPool reload blocked: persistent or runtime evidence is inconsistent' >&2
		discard_desired_snapshot
		return 1
	fi
	previous="$PROXYPOOL_RUNTIME_BACKEND"
	backend="$PROXYPOOL_ACTIVATED_BACKEND"
	if [ "$backend" = v2_shadow ] && legacy_runtime_evidence_exists; then
		echo 'ProxyPool reload blocked: conflicting legacy runtime evidence exists' >&2
		discard_desired_snapshot
		return 1
	fi
	state=$(capture_procd_state)
	[ "$state" != unknown ] || {
		echo 'ProxyPool reload blocked: procd state is unknown' >&2
		discard_desired_snapshot
		return 1
	}
	if [ "$previous" = v1 ] && [ "$state" != absent ]; then
		echo 'ProxyPool V1 reload blocked: a procd instance is still present' >&2
		discard_desired_snapshot
		return 1
	fi
	if [ -z "$previous" ]; then
		PROXYPOOL_START_PREPARED=1
		PROXYPOOL_START_BACKEND="$PROXYPOOL_DESIRED_BACKEND"
		PROXYPOOL_START_CLASS="$PROXYPOOL_DESIRED_CLASS"
		PROXYPOOL_START_ENABLED="$PROXYPOOL_DESIRED_ENABLED"
		PROXYPOOL_START_SNAPSHOT="$PROXYPOOL_DESIRED_SNAPSHOT"
		PROXYPOOL_DESIRED_SNAPSHOT=
		start
		return
	fi

	if [ "$PROXYPOOL_DESIRED_ENABLED" = 0 ]; then
		begin_backend_mutation || {
			discard_desired_snapshot
			return 1
		}
		case "$backend" in
			v1)
				if ! v1_snapshot_matches_live; then
					discard_desired_snapshot
					clear_cleanup_required v1 || true
					return 1
				fi
				if ! legacy_stop; then
					record_v1_cleanup_required
					discard_desired_snapshot
					return 1
				fi
				;;
			v2_shadow)
				discard_desired_snapshot
				procd_kill proxypool || true
				;;
		esac
		state=$(capture_procd_state)
		[ "$state" = absent ] || return 1
		discard_desired_snapshot
		finish_confirmed_cleanup "$backend" || return 1
		return 0
	fi

	if [ "$backend" = v1 ]; then
		begin_backend_mutation || {
			discard_desired_snapshot
			return 1
		}
		if ! v1_snapshot_matches_live; then
			discard_desired_snapshot
			clear_cleanup_required v1 || true
			return 1
		fi
		if legacy_reload; then result=0; else result=$?; fi
		if [ "$result" -eq 0 ]; then
			discard_desired_snapshot
			clear_cleanup_required v1 || return 1
			return 0
		fi
		if ! v1_snapshot_matches_live || ! legacy_stop; then
			record_v1_cleanup_required
			discard_desired_snapshot
			return "$result"
		fi
		discard_desired_snapshot
		finish_confirmed_cleanup v1 || true
		return "$result"
	fi

	PROXYPOOL_START_PREPARED=1
	PROXYPOOL_START_BACKEND="$PROXYPOOL_DESIRED_BACKEND"
	PROXYPOOL_START_CLASS="$PROXYPOOL_DESIRED_CLASS"
	PROXYPOOL_START_ENABLED="$PROXYPOOL_DESIRED_ENABLED"
	PROXYPOOL_START_SNAPSHOT="$PROXYPOOL_DESIRED_SNAPSHOT"
	PROXYPOOL_DESIRED_SNAPSHOT=
	if start; then result=0; else result=$?; fi
	PROXYPOOL_START_PREPARED=0
	return "$result"
}

service_triggers() {
	procd_add_reload_trigger proxypool proxypool_v2 proxypool_runtime
}
