#!/bin/sh
# ProxyPool 首次安装初始化脚本

# 确保目录存在
mkdir -p /var/run/proxypool
mkdir -p /var/log/proxypool

# 设置权限
chmod +x /usr/lib/proxypool/*.sh

# 初始化配置（如果不存在）
if [ ! -f /etc/config/proxypool ]; then
    cat > /etc/config/proxypool << 'EOF'
config global 'global'
    option enabled '1'
    option max_clients '60'
    option log_level 'info'
    option status_interval '30'
EOF
fi

# 启用服务
/etc/init.d/proxypool enable

exit 0
