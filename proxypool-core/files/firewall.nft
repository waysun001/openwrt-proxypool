#!/usr/sbin/nft -f
# ProxyPool nftables 规则模板

table inet proxypool {
    # 允许的IP集合
    set allowed_ips {
        type ipv4_addr
        flags interval
    }

    # 客户端标记集合
    set client_marks {
        type mark
    }

    # 前置路由链
    chain prerouting {
        type filter hook prerouting priority -150; policy accept;

        # TPROXY for SOCKS5 UDP
        # 由脚本动态添加规则
    }

    # 输出链
    chain output {
        type filter hook output priority -150; policy accept;
    }

    # 转发链
    chain forward {
        type filter hook forward priority -1; policy accept;

        # 允许内网互访
        ip saddr 192.168.0.0/16 ip daddr 192.168.0.0/16 accept
        ip saddr 10.0.0.0/8 ip daddr 10.0.0.0/8 accept
        ip saddr 172.16.0.0/12 ip daddr 172.16.0.0/12 accept

        # 允许已建立的连接
        ct state established,related accept

        # 允许在白名单中的IP（由脚本动态管理）
        ip saddr @allowed_ips accept

        # 默认拒绝内网访问外网
        ip saddr 192.168.0.0/16 ip daddr != 192.168.0.0/16 drop
        ip saddr 10.0.0.0/8 ip daddr != 10.0.0.0/8 drop
        ip saddr 172.16.0.0/12 ip daddr != 172.16.0.0/12 drop
    }

    # NAT 前置路由
    chain nat_prerouting {
        type nat hook prerouting priority -100; policy accept;

        # TCP 重定向到 redsocks (SOCKS5)
        # 由脚本动态添加规则
    }

    # NAT 后置路由
    chain nat_postrouting {
        type nat hook postrouting priority 100; policy accept;

        # L2TP 接口的 MASQUERADE
        # 由脚本动态添加规则
    }
}
