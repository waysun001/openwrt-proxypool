#!/bin/sh

# 添加 LuCI 菜单
uci -q batch << EOF
delete ucitrack.@proxypool[-1]
add ucitrack proxypool
set ucitrack.@proxypool[-1].init=proxypool
commit ucitrack
EOF

# 设置 LAN IP 为 192.168.9.1
uci -q batch << 'LANEOF'
set network.lan.ipaddr='192.168.9.1'
commit network
LANEOF

# 禁用系统 xl2tpd 自启动（智联盒子使用独立 xl2tpd 实例）
if [ -x /etc/init.d/xl2tpd ]; then
    /etc/init.d/xl2tpd stop 2>/dev/null
    /etc/init.d/xl2tpd disable 2>/dev/null
fi

# 将 PPP 接口加入 WAN 防火墙 zone（fw4 默认不认识 ppp 接口，会丢弃转发流量）
uci -q batch << 'FWEOF'
add_list firewall.@zone[1].device='ppp-+'
commit firewall
FWEOF

# ===== 全局 UI 定制（JS 版 LuCI 兼容方案）=====

# 1. 写入全局导航 JS（硬编码菜单 + 自带 CSS 注入，所有页面统一渲染）
cat > /www/luci-static/resources/proxypool-global.js << 'PPJS'
(function(){
'use strict';
injectCSS();
if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',build)}else{build()}
function build(){
if(document.getElementById('proxypool-global-menu'))return;
var items=[
{l:'\u667A\u8054\u76D2\u5B50',h:'/cgi-bin/luci/admin/services/proxypool'},
{l:'\u7CFB\u7EDF\u65E5\u5FD7',h:'/cgi-bin/luci/admin/services/proxypool?tab=log'},
{l:'\u4FE1\u9053\u5206\u6790',h:'/cgi-bin/luci/admin/status/channel_analysis'},
{l:'\u5907\u4EFD\u4E0E\u5347\u7EA7',h:'/cgi-bin/luci/admin/system/flash'},
{l:'\u65E0\u7EBF',h:'/cgi-bin/luci/admin/network/wireless'},
{l:'\u91CD\u542F',h:'/cgi-bin/luci/admin/system/reboot'}
];
var menu=document.createElement('div');menu.id='proxypool-global-menu';
var ld=document.createElement('div');ld.className='menu-links';
var p=window.location.pathname.replace(/\/+$/,''),s=window.location.search||'';
items.forEach(function(it){
var a=document.createElement('a');a.href=it.h;a.textContent=it.l;
var qi=it.h.indexOf('?'),ip=qi>=0?it.h.substring(0,qi):it.h,is=qi>=0?it.h.substring(qi):'';
if(is){if(p===ip&&s===is)a.className='active'}
else{if(p===ip&&!s)a.className='active'}
ld.appendChild(a)});
var sd=document.createElement('div');sd.className='menu-stats';
sd.innerHTML='<span>\u603B <strong id="pp-stat-total">-</strong></span><span class="stat-connected">\u5DF2\u8FDE\u63A5 <strong id="pp-stat-connected">-</strong></span><span class="stat-disconnected">\u672A\u8FDE\u63A5 <strong id="pp-stat-disconnected">-</strong></span>';
menu.appendChild(ld);menu.appendChild(sd);
var anchor=document.querySelector('#maincontent')||document.querySelector('.main-right')||document.querySelector('.main')||document.querySelector('#content');
if(anchor&&anchor.parentNode){anchor.parentNode.insertBefore(menu,anchor)}
else{document.body.insertBefore(menu,document.body.firstChild)}
us();setInterval(us,10000)}
function injectCSS(){
if(document.getElementById('pp-global-menu-css'))return;
var s=document.createElement('style');s.id='pp-global-menu-css';
s.textContent='#proxypool-global-menu{display:flex;justify-content:space-between;align-items:center;background:linear-gradient(135deg,#1a1a2e 0%,#16213e 100%);padding:0 24px;height:52px;font-size:14px;box-shadow:0 2px 8px rgba(0,0,0,0.15);max-width:1840px;margin:0 auto;border-radius:0 0 8px 8px}#proxypool-global-menu .menu-links{display:flex;gap:4px;flex-wrap:wrap;align-items:center;height:100%}#proxypool-global-menu .menu-links a{padding:6px 18px;background:transparent;color:rgba(255,255,255,0.75);border:none;border-radius:6px;text-decoration:none;transition:all 0.2s ease;font-weight:500;font-size:14px;letter-spacing:0.3px}#proxypool-global-menu .menu-links a:hover{background:rgba(255,255,255,0.12);color:#fff}#proxypool-global-menu .menu-links a.active{background:rgba(255,255,255,0.18);color:#fff;box-shadow:inset 0 -2px 0 #4fc3f7}#proxypool-global-menu .menu-stats{display:flex;gap:16px;font-size:13px;white-space:nowrap;align-items:center}#proxypool-global-menu .menu-stats span{color:rgba(255,255,255,0.6)}#proxypool-global-menu .menu-stats strong{font-weight:700;font-size:15px;color:rgba(255,255,255,0.9)}#proxypool-global-menu .menu-stats .stat-connected{color:#66bb6a}#proxypool-global-menu .menu-stats .stat-connected strong{color:#66bb6a}#proxypool-global-menu .menu-stats .stat-disconnected{color:#ef5350}#proxypool-global-menu .menu-stats .stat-disconnected strong{color:#ef5350}';
document.head.appendChild(s)}
function us(){
fetch('/cgi-bin/luci/admin/services/proxypool/api?action=status')
.then(function(r){return r.json()})
.then(function(d){if(d&&d.summary){
var e;e=document.getElementById('pp-stat-total');if(e)e.textContent=d.summary.total;
e=document.getElementById('pp-stat-connected');if(e)e.textContent=d.summary.connected;
e=document.getElementById('pp-stat-disconnected');if(e)e.textContent=d.summary.disconnected}})
.catch(function(){});}
})();
PPJS

# 2. 追加全局 CSS 到所有 bootstrap 主题的 cascade.css
for CSS_FILE in /www/luci-static/bootstrap/cascade.css \
                /www/luci-static/bootstrap-dark/cascade.css \
                /www/luci-static/bootstrap-light/cascade.css; do
    [ -f "$CSS_FILE" ] || continue
    grep -q "pp-wide-layout" "$CSS_FILE" && continue
    cat >> "$CSS_FILE" << 'PPCSS'

/* proxypool-global: hide sidebar, full width */
html.pp-wide-layout header,html.pp-wide-layout .header,html.pp-wide-layout #header,html.pp-wide-layout .main-left,html.pp-wide-layout #mainmenu,html.pp-wide-layout .navbar-static-top,html.pp-wide-layout #navigation{display:none!important}
html.pp-wide-layout .main-right{width:100%!important;margin-left:0!important;float:none!important}
html.pp-wide-layout .main{display:block!important}
html.pp-wide-layout #maincontent{max-width:1840px;margin:0 auto;padding:0 20px}
#proxypool-global-menu{display:flex;justify-content:space-between;align-items:center;background:linear-gradient(135deg,#1a1a2e 0%,#16213e 100%);padding:0 24px;height:52px;font-size:14px;box-shadow:0 2px 8px rgba(0,0,0,0.15);max-width:1840px;margin:0 auto;border-radius:0 0 8px 8px}
#proxypool-global-menu .menu-links{display:flex;gap:4px;flex-wrap:wrap;align-items:center;height:100%}
#proxypool-global-menu .menu-links a{padding:6px 18px;background:transparent;color:rgba(255,255,255,0.75);border:none;border-radius:6px;text-decoration:none;transition:all 0.2s ease;font-weight:500;font-size:14px;letter-spacing:0.3px}
#proxypool-global-menu .menu-links a:hover{background:rgba(255,255,255,0.12);color:#fff}
#proxypool-global-menu .menu-links a.active{background:rgba(255,255,255,0.18);color:#fff;box-shadow:inset 0 -2px 0 #4fc3f7}
#proxypool-global-menu .menu-stats{display:flex;gap:16px;font-size:13px;white-space:nowrap;align-items:center}
#proxypool-global-menu .menu-stats span{color:rgba(255,255,255,0.6)}
#proxypool-global-menu .menu-stats strong{font-weight:700;font-size:15px;color:rgba(255,255,255,0.9)}
#proxypool-global-menu .menu-stats .stat-connected{color:#66bb6a}
#proxypool-global-menu .menu-stats .stat-connected strong{color:#66bb6a}
#proxypool-global-menu .menu-stats .stat-disconnected{color:#ef5350}
#proxypool-global-menu .menu-stats .stat-disconnected strong{color:#ef5350}
PPCSS
done

# 3. 在 luci.js 末尾追加 loader（立即隐藏侧边栏 + 默认首页重定向 + 加载全局JS）
LUCI_JS="/www/luci-static/resources/luci.js"
if [ -f "$LUCI_JS" ] && ! grep -q "proxypool-global" "$LUCI_JS"; then
    cat >> "$LUCI_JS" << 'PPLOADER'

/* proxypool-global */document.documentElement.className+=' pp-wide-layout';(function(){var p=window.location.pathname.replace(/\/+$/,'');if(p==='/cgi-bin/luci/admin'||p==='/cgi-bin/luci/admin/status'||p==='/cgi-bin/luci/admin/status/overview'){window.location.replace('/cgi-bin/luci/admin/services/proxypool')}var s=document.createElement('script');s.src='/luci-static/resources/proxypool-global.js';document.head.appendChild(s)})();
PPLOADER
fi

# 清理缓存
rm -f /tmp/luci-indexcache
rm -rf /tmp/luci-modulecache

exit 0
