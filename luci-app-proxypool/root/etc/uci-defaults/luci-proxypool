#!/bin/sh

# 添加 LuCI 菜单
uci -q batch << EOF
delete ucitrack.@proxypool[-1]
add ucitrack proxypool
set ucitrack.@proxypool[-1].init=proxypool
commit ucitrack
EOF

# 禁用系统 xl2tpd 自启动（智联盒子使用独立 xl2tpd 实例）
if [ -x /etc/init.d/xl2tpd ]; then
    /etc/init.d/xl2tpd stop 2>/dev/null
    /etc/init.d/xl2tpd disable 2>/dev/null
fi

# 将 PPP 接口加入 WAN 防火墙 zone（fw4 默认不认识 ppp 接口，会丢弃转发流量）
uci -q batch << 'FWEOF'
add_list firewall.@zone[1].device='ppp-+'
commit firewall
FWEOF

# 注入全局 CSS/JS 到所有 LuCI 主题的 header 模板
MARKER="proxypool-global"
for HEADER in /usr/lib/lua/luci/view/themes/*/header.htm; do
    [ -f "$HEADER" ] || continue
    grep -q "$MARKER" "$HEADER" && continue
    awk '
    /<\/head>/ {
        print "<!-- " "proxypool-global" " -->"
        print "<link rel=\"stylesheet\" href=\"/luci-static/resources/proxypool-global.css\">"
        print "<script>document.documentElement.className+=\" pp-wide-layout\";</script>"
        print "<script src=\"/luci-static/resources/proxypool-global.js\" defer></script>"
    }
    { print }
    ' "$HEADER" > "$HEADER.tmp" && mv "$HEADER.tmp" "$HEADER"
done

# 清理缓存
rm -f /tmp/luci-indexcache
rm -rf /tmp/luci-modulecache

exit 0
