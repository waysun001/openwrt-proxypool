# Target
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-mt6000=y

# Image
CONFIG_TARGET_ROOTFS_PARTSIZE=512

# Kernel
CONFIG_KERNEL_BUILD_USER="proxypool"
CONFIG_KERNEL_BUILD_DOMAIN="local"

# Luci
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-proxypool=y
CONFIG_LUCI_LANG_zh_Hans=y

# Luci Apps
CONFIG_PACKAGE_luci-app-proxypool=y

# ProxyPool Core
CONFIG_PACKAGE_proxypool-core=y

# L2TP
CONFIG_PACKAGE_xl2tpd=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppol2tp=y
CONFIG_PACKAGE_kmod-l2tp=y
CONFIG_PACKAGE_kmod-pppol2tp=y

# SOCKS5 (redsocks for transparent proxy)
CONFIG_PACKAGE_redsocks=y

# Firewall
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-nat=y

# IP Route
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_ipset=y

# Utilities
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-stat=y

# Monitoring
CONFIG_PACKAGE_vnstat2=y
CONFIG_PACKAGE_luci-app-vnstat2=y

# SSH
CONFIG_PACKAGE_openssh-sftp-server=y

# Wireless
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set

# USB
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y

# Filesystem
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y

# Additional
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
