#!/bin/sh

[ "${INTERFACE:-}" = wan ] || exit 0
case "${ACTION:-}" in
	ifup|ifupdate) : ;;
	*) exit 0 ;;
esac

SYSNTPD="${PROXYPOOL_SYSNTPD:-/etc/init.d/sysntpd}"
TIME_BOOTSTRAP="${PROXYPOOL_TIME_BOOTSTRAP:-/usr/lib/zeanlink/time-bootstrap.sh}"
[ -x "$SYSNTPD" ] || exit 0
"$SYSNTPD" reload >/dev/null 2>&1 || "$SYSNTPD" restart >/dev/null 2>&1 || :
[ -f "$TIME_BOOTSTRAP" ] && sh "$TIME_BOOTSTRAP" >/dev/null 2>&1 || :
"$SYSNTPD" reload >/dev/null 2>&1 || "$SYSNTPD" restart >/dev/null 2>&1 || :

exit 0
