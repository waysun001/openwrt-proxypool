#!/bin/sh
set -eu

# Generate the target's stock wireless configuration if it is absent.  On a
# fresh GL-MT6000 image only, configure the two stock APs with authenticated
# ZeanLink credentials and both hostapd and bridge-port station isolation
# before enabling either radio.  Existing user wireless configuration is never
# overwritten during package upgrades or later boots.

WIRELESS_CONFIG="${PROXYPOOL_WIRELESS_CONFIG:-/etc/config/wireless}"
WIFI="${PROXYPOOL_WIFI:-/sbin/wifi}"
UCI="${PROXYPOOL_UCI:-/sbin/uci}"
LAN_ISOLATION="${PROXYPOOL_LAN_ISOLATION:-/usr/lib/proxypool/lan-isolation.sh}"
STAT="${PROXYPOOL_STAT:-/bin/stat}"
CHMOD="${PROXYPOOL_CHMOD:-/bin/chmod}"
SLEEP="${PROXYPOOL_WIRELESS_SLEEP:-/bin/sleep}"

fail() {
	echo "ZeanLink wireless default: $*" >&2
	exit 1
}

case "$WIRELESS_CONFIG" in
	/*) : ;;
	*) fail "unsafe relative wireless config path: $WIRELESS_CONFIG" ;;
esac
[ "$WIRELESS_CONFIG" != / ] || fail 'refusing filesystem-root wireless config path'

FRESH_CONFIG=0
if [ ! -e "$WIRELESS_CONFIG" ] && [ ! -L "$WIRELESS_CONFIG" ]; then
	[ -x "$WIFI" ] || fail "wifi is not executable: $WIFI"
	"$WIFI" config 2>/dev/null || fail 'cannot generate the stock wireless config'
	FRESH_CONFIG=1
fi

[ -f "$WIRELESS_CONFIG" ] && [ ! -L "$WIRELESS_CONFIG" ] ||
	fail 'wireless config is missing, linked, or not a regular file'
# mac80211.hotplug touches this file before PHY enumeration.  An empty regular
# file during the image's one-shot default phase is therefore still transient
# factory state, even when the hotplug worker won the path-creation race.
[ -s "$WIRELESS_CONFIG" ] || FRESH_CONFIG=1
[ -x "$STAT" ] || fail "stat is not executable: $STAT"
metadata=$("$STAT" -c '%a %u %h' "$WIRELESS_CONFIG" 2>/dev/null) ||
	fail 'cannot inspect wireless config ownership'
case "$metadata" in
	""|*'
'*) fail 'malformed wireless config ownership metadata' ;;
esac
mode=${metadata%% *}
rest=${metadata#* }
owner=${rest%% *}
links=${rest#* }
[ "$owner" = 0 ] || fail 'wireless config is not root-owned'
[ "$links" = 1 ] || fail 'wireless config has an unsafe hard-link alias'

# `wifi config` uses touch under OpenWrt 23.05, so a normal first-boot umask
# creates 0644.  Credentials must be private before the isolation helper ever
# copies the file into its transaction stage.  Re-apply this on upgrades too.
[ -x "$CHMOD" ] || fail "chmod is not executable: $CHMOD"
"$CHMOD" 600 "$WIRELESS_CONFIG" || fail 'cannot make wireless config root-only'
metadata=$("$STAT" -c '%a %u %h' "$WIRELESS_CONFIG" 2>/dev/null) ||
	fail 'cannot verify wireless config permissions'
[ "$metadata" = '600 0 1' ] || fail 'wireless config did not converge to private single-link root ownership'

factory_stock_config() {
	sections=$("$UCI" -q show wireless 2>/dev/null |
		sed -n 's/^wireless\.\([^.=]*\)=[^=]*$/\1/p') || return 1
	[ "$(printf '%s\n' "$sections" | sed '/^$/d' | wc -l | tr -d '[:space:]')" = 4 ] ||
		return 1
	for expected_section in radio0 default_radio0 radio1 default_radio1; do
		printf '%s\n' "$sections" | grep -Fxq "$expected_section" || return 1
	done

	[ "$("$UCI" -q get wireless.radio0 2>/dev/null)" = wifi-device ] || return 1
	radio0_band=$("$UCI" -q get wireless.radio0.band 2>/dev/null) || return 1
	[ "$("$UCI" -q get wireless.radio0.disabled 2>/dev/null)" = 1 ] || return 1
	[ "$("$UCI" -q get wireless.radio1 2>/dev/null)" = wifi-device ] || return 1
	radio1_band=$("$UCI" -q get wireless.radio1.band 2>/dev/null) || return 1
	case "$radio0_band:$radio1_band" in
		2g:5g|5g:2g) : ;;
		*) return 1 ;;
	esac
	[ "$("$UCI" -q get wireless.radio1.disabled 2>/dev/null)" = 1 ] || return 1
	for radio in radio0 radio1; do
		iface="default_$radio"
		[ "$("$UCI" -q get "wireless.$iface" 2>/dev/null)" = wifi-iface ] || return 1
		[ "$("$UCI" -q get "wireless.$iface.device" 2>/dev/null)" = "$radio" ] || return 1
		[ "$("$UCI" -q get "wireless.$iface.mode" 2>/dev/null)" = ap ] || return 1
		[ "$("$UCI" -q get "wireless.$iface.network" 2>/dev/null)" = lan ] || return 1
		[ "$("$UCI" -q get "wireless.$iface.ssid" 2>/dev/null)" = OpenWrt ] || return 1
		[ "$("$UCI" -q get "wireless.$iface.encryption" 2>/dev/null)" = none ] || return 1
		if "$UCI" -q get "wireless.$iface.disabled" >/dev/null 2>&1 ||
			"$UCI" -q get "wireless.$iface.key" >/dev/null 2>&1 ||
			"$UCI" -q get "wireless.$iface.isolate" >/dev/null 2>&1 ||
			"$UCI" -q get "wireless.$iface.bridge_isolate" >/dev/null 2>&1; then
			return 1
		fi
	done
	return 0
}

wait_for_factory_stock_config() {
	attempt=1
	while [ "$attempt" -le 30 ]; do
		factory_stock_config && return 0
		[ "$attempt" -lt 30 ] || return 1
		"$SLEEP" 1 || return 1
		attempt=$((attempt + 1))
	done
	return 1
}

wait_for_factory_wireless_quiescence() {
	attempt=1
	stable_observations=0
	while [ "$attempt" -le 30 ]; do
		pending=$("$UCI" -q changes wireless 2>/dev/null) || return 1
		if [ -z "$pending" ]; then
			stable_observations=$((stable_observations + 1))
			[ "$stable_observations" -ge 2 ] && return 0
		else
			stable_observations=0
		fi
		[ "$attempt" -lt 30 ] || return 1
		"$SLEEP" 1 || return 1
		attempt=$((attempt + 1))
	done
	return 1
}

# mac80211.hotplug starts during S10 kmodloader, but its worker is asynchronous:
# it may commit the stock wireless package before this script or shortly after
# an early `wifi config` has only touched an empty file.  A path-existence test
# therefore cannot distinguish factory state from preserved user state.  Wait
# only on the fresh-file path, and recognize only the exact disabled, open,
# two-radio stock topology; any user-visible change remains untouched.
[ -x "$UCI" ] || fail "uci is not executable: $UCI"
[ -x "$LAN_ISOLATION" ] || fail "LAN isolation helper is not executable: $LAN_ISOLATION"
FACTORY_CONFIG=0
if [ "$FRESH_CONFIG" -eq 1 ]; then
	[ -x "$SLEEP" ] || fail "sleep is not executable: $SLEEP"
	wait_for_factory_stock_config ||
		fail 'timed out waiting for mac80211 to generate the stock wireless config'
	FACTORY_CONFIG=1
elif factory_stock_config; then
	FACTORY_CONFIG=1
fi

validate_factory_ap() {
	radio=$1
	iface=$2

	[ "$("$UCI" -q get "wireless.$radio" 2>/dev/null)" = wifi-device ] ||
		fail "fresh wireless config is missing $radio"
	case "$("$UCI" -q get "wireless.$radio.band" 2>/dev/null)" in
		2g|5g) : ;;
		*) fail "fresh wireless config has an unexpected band for $radio" ;;
	esac
	[ "$("$UCI" -q get "wireless.$iface" 2>/dev/null)" = wifi-iface ] ||
		fail "fresh wireless config is missing $iface"
	[ "$("$UCI" -q get "wireless.$iface.device" 2>/dev/null)" = "$radio" ] ||
		fail "fresh wireless interface $iface uses the wrong radio"
	[ "$("$UCI" -q get "wireless.$iface.mode" 2>/dev/null)" = ap ] ||
		fail "fresh wireless interface $iface is not an AP"
	[ "$("$UCI" -q get "wireless.$iface.network" 2>/dev/null)" = lan ] ||
		fail "fresh wireless interface $iface is not attached only to LAN"
}

factory_ssid() {
	case "$("$UCI" -q get "wireless.$1.band" 2>/dev/null)" in
		2g) printf '%s\n' ZeanLink-2.4G ;;
		5g) printf '%s\n' ZeanLink-5G ;;
		*) return 1 ;;
	esac
}

apply_factory_ap() {
	radio=$1
	iface=$2
	ssid=$3
	"$UCI" -q set "wireless.$iface.ssid=$ssid" &&
		"$UCI" -q set "wireless.$iface.encryption=psk2" &&
		"$UCI" -q set "wireless.$iface.key=12345678" &&
		"$UCI" -q set "wireless.$iface.isolate=1" &&
		"$UCI" -q set "wireless.$iface.bridge_isolate=1" &&
		"$UCI" -q set "wireless.$iface.disabled=0" &&
		"$UCI" -q set "wireless.$radio.disabled=0"
}

if [ "$FACTORY_CONFIG" -eq 1 ]; then
	validate_factory_ap radio0 default_radio0
	validate_factory_ap radio1 default_radio1
	radio0_ssid=$(factory_ssid radio0) || fail 'cannot classify the factory radio0 band'
	radio1_ssid=$(factory_ssid radio1) || fail 'cannot classify the factory radio1 band'
	[ "$radio0_ssid" != "$radio1_ssid" ] || fail 'factory radios do not expose distinct bands'
	if ! apply_factory_ap radio0 default_radio0 "$radio0_ssid" ||
		! apply_factory_ap radio1 default_radio1 "$radio1_ssid" ||
		! "$UCI" -q commit wireless; then
		"$UCI" -q revert wireless >/dev/null 2>&1 || :
		fail 'cannot atomically configure the fresh authenticated wireless APs'
	fi
	# Recheck after libuci rewrites the file so credentials never become
	# world-readable even under an unexpectedly permissive first-boot umask.
	"$CHMOD" 600 "$WIRELESS_CONFIG" || fail 'cannot protect committed wireless credentials'
	metadata=$("$STAT" -c '%a %u %h' "$WIRELESS_CONFIG" 2>/dev/null) ||
		fail 'cannot verify committed wireless config permissions'
	[ "$metadata" = '600 0 1' ] || fail 'committed wireless credentials are not root-only'
	[ -x "$SLEEP" ] || fail "sleep is not executable: $SLEEP"
	if ! wait_for_factory_wireless_quiescence; then
		echo 'ZeanLink wireless default: mac80211 UCI writes did not quiesce; entering fail-closed isolation' >&2
		"$LAN_ISOLATION" boot || exit $?
		exit 0
	fi
fi

# /etc/uci-defaults runs at S10, before netifd registers network.wireless.
# `boot` permits only that cold-start object-absent proof; a runtime configure
# must always obtain the complete radio status from netifd.
"$LAN_ISOLATION" boot
