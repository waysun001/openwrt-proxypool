# 智联盒子默认配置

config global 'global'
    option enabled '1'
    option max_clients '60'
    option log_level 'info'
    # 使用期限：默认 360 天，0 表示永久解锁。按累计开机运行时长计时（抗改系统时间），lease_used 由 lease.sh 维护
    option lease_days '360'

